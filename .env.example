# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env.
# On hosts that support real environment variables (cPanel -> "Setup PHP",
# Plesk, systemd, SetEnv in .htaccess) prefer those: they win over this file.
# ---------------------------------------------------------------------------

# --- App ---
APP_TIMEZONE=Asia/Tehran
APP_DEBUG=false
# false = generate + preview only, never publish automatically
AUTO_MODE=true
LOG_LEVEL=info

# Move runtime directories outside public_html if your host allows it:
# BOT_DATA_DIR=/home/USER/bot-private/data
# BOT_LOG_DIR=/home/USER/bot-private/logs
# BOT_STORAGE_DIR=/home/USER/bot-private/storage
# BOT_SECRETS_FILE=/home/USER/bot-private/secrets.php

# --- Telegram ---
# From @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Channel username (@YourChannel) or numeric id (-1001234567890)
TELEGRAM_CHANNEL_ID=@YourChannel
# Your numeric Telegram user id(s) (from @userinfobot). Comma-separated for several admins.
TELEGRAM_ADMIN_IDS=123456789
# Only needed when using webhook.php; generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string
TELEGRAM_WEBHOOK_URL=https://your-domain.example/telegram-content-bot/webhook.php

# --- Hugging Face (DeepSeek) ---
# https://huggingface.co/settings/tokens  (needs "Make calls to Inference Providers")
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_MODEL=deepseek-ai/DeepSeek-V3
HF_ENDPOINT=https://router.huggingface.co/v1/chat/completions
HF_TEMPERATURE=0.7
HF_MAX_TOKENS=1600
HF_TIMEOUT=120

# --- Search (optional but strongly recommended for news topics) ---
SEARCH_ENABLED=false
SEARCH_PROVIDERS=tavily,serper,brave,duckduckgo
SEARCH_TAVILY_KEY=
SEARCH_SERPER_KEY=
SEARCH_BRAVE_KEY=
SEARCH_MAX_SOURCES=4
SEARCH_MAX_AGE_DAYS=45
SEARCH_VERIFY_URLS=true
# Comma-separated overrides for the built-in lists:
# SEARCH_TRUSTED_DOMAINS=php.net,python.org,github.blog
SEARCH_BLOCKED_DOMAINS=medium.com,w3schools.com

# --- Content ---
CONTENT_LANGUAGE=fa
CONTENT_MIN_WORDS=90
CONTENT_MAX_WORDS=300
CONTENT_MIN_CONFIDENCE=0.5
CONTENT_CTA_EVERY=4
# Extra forbidden openings, separated by "|"
# CONTENT_BANNED_PHRASES=در دنیای امروز|با پیشرفت روزافزون

# --- Schedule ---
POST_INTERVAL_HOURS=8
POST_RETRY_AFTER_MINUTES=45
LOCK_STALE_AFTER_SECONDS=900

# --- HTTP cron trigger (only if your host has no real cron; else leave empty) ---
# Then call: https://your-domain.example/telegram-content-bot/cron.php?key=THIS_VALUE
CRON_SECRET=generate-a-random-string-too
